{
  "name": "orderium-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Prints Orderium documents on shop hardware the browser cannot reach",
  "main": "dist/index.js",
  "bin": {
    "orderium-print-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "pair": "ts-node src/index.ts pair",
    "test": "jest"
  },
  "dependencies": {
    "pdf-to-printer": "^5.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
