{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@orderium/ui": [
        "../shared/ui/src"
      ],
      "@orderium/ui/*": [
        "../shared/ui/src/*"
      ],
      "@shared-logo/*": [
        "../shared/logo/*"
      ],
      "@shared-print": [
        "../shared/components"
      ],
      "@shared-print/*": [
        "../shared/components/*"
      ],
      /* @hookform/resolvers takes zod as an unlinked peer, so TypeScript walks
         up to the pnpm store and picks zod 4 — while this app is on zod 3.
         Pin both importers to the same copy. */
      "zod": [
        "./node_modules/zod"
      ],
      "zod/*": [
        "./node_modules/zod/*"
      ]
    }
  },
  "include": [
    "src",
    "../shared/ui/src"
  ]
}